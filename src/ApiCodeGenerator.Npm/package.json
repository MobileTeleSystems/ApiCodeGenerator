{
  "name": "api-code-generator",
  "version": "3.0.0",
  "author": {
    "name": "Gennady Pundikov",
    "email": "gvpundik@mts.ru"
  },
  "dependencies": {
    "detect-libc": "^2.1.2",
    "nswag": "14.6.1",
    "tar": "^6.2.1"
  },
  "bin": {
    "acg": "acg-cli.js"
  },
  "main": "acg.js",
  "types": "acg.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/MobileTeleSystems/ApiCodeGenerator"
  },
  "license": "MIT",
  "scripts": {
    "test": "jest",
    "build": "tsc -p tsconfig.base.json",
    "binaries": "dotnet publish ../ApiCodeGenerator.MSBuild/ApiCodeGenerator.MSBuild.csproj -c Release -f net8.0 -o binaries -p:CodeAnalysisRuleSet= -p:SatelliteResourceLanguages=None",
    "pack": "mkdirp dist && npm run pack-ci -- dist",
    "pack-ci": "npm run binaries && npm run build && npm  pack --pack-destination "
  },
  "devDependencies": {
    "@babel/plugin-transform-typescript": "^7.28.5",
    "@types/jest": "^29.5.14",
    "jest": "^29.7.0",
    "mkdirp": "^3.0.1",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
