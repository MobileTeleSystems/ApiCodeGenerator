{
  "compilerOptions": {
    "target": "ES2020",
    "module": "umd",
    "lib": [
      "ES2020"
    ],
    "outDir": "./",
    "rootDir": "./",
    "strict": true,
    "checkJs": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "types": [
      "node",
      "jest"
    ]
  },
  "exclude": [
    "node_modules",
    "dist"
  ],
  "include": [
    "acg.ts"
  ]
}
